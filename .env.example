# LLM provider: "ollama" for local/free, "openrouter" for API based usage.
LLM_PROVIDER=ollama

# Local Ollama model.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local supervisor model. This checks SQL before execute_query runs.
SUPERVISOR_ENABLED=true
SUPERVISOR_MODEL=qwen2.5:7b
SUPERVISOR_BASE_URL=http://127.0.0.1:11434
SUPERVISOR_FAIL_CLOSED=true

# Demo application user for table-level permission checks.
# Known users: guest, analyst_user, sales_user, support_user, erkut, admin.
APP_USER=guest

# Conversation memory backed by PostgreSQL (LangGraph AsyncPostgresSaver).
# When enabled, the agent remembers prior turns within the same thread_id.
MEMORY_ENABLED=true

# OpenRouter settings. Only needed when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=your_openrouter_api_key_here
CHAT_MODEL=openai:openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Chinook PostgreSQL database running in Docker.
# Set strong values before running docker compose up or the MCP server.
POSTGRES_DB=chinook
POSTGRES_USER=replace_with_db_user
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql://replace_with_db_user:replace_with_strong_password@localhost:5433/chinook

# MCP server settings.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TRANSPORT=streamable_http

# Strict mode: true (default) = prompt + SQL supervisor both run.
# false = only SQL-level supervisor runs (~50% faster, same deterministic security).
SUPERVISOR_STRICT=true
